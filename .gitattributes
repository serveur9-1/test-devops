# Normalise les fins de ligne dans le dépôt.
* text=auto

# Ces fichiers sont exécutés sous Linux : un CRLF les casse.
# Un script shell en CRLF échoue sur « $'\r': command not found », et les
# continuations « \ » d'un Dockerfile ne sont plus reconnues.
*.sh        text eol=lf
Dockerfile  text eol=lf
